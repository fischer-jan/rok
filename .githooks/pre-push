#!/usr/bin/env bash
# Rok's checks before a push (turn on once per clone: git config core.hooksPath .githooks).
#   - fails when a tracked file in the pushed commit is over 20 MB;
#   - fails when the pushed commits add or change more than 10 MB of binaries;
#   - warns when the whole history is over 400 MB (GitHub's soft limit is 1 GB);
#   - runs every check of scripts/check.sh (build, tests, lint, licences, audit, secrets)
#     and fails when one of them fails.
# Sizes come from git's own objects, so the hook reads the same on macOS and Linux.
# Big source assets, renders and previews belong outside git. `git push --no-verify` skips it.
set -euo pipefail

MAX_FILE_MB=20
MAX_ADDED_MB=10
WARN_HISTORY_MB=400
BINARY='\.(png|jpe?g|webp|gif|tiff?|bmp|heic|psd|glb|gltf|fbx|obj|blend|vox|zip|7z|tar|gz|bundle|mp4|mov|wav|mp3|pdf|docx)$'
ZERO=0000000000000000000000000000000000000000

repo="$(git rev-parse --show-toplevel)"
cd "$repo"
fail=0
checked=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue  # a branch deleted on the remote: nothing to check
  checked=1
  big=$(git ls-tree -r -l "$local_sha" | awk -v m=$((MAX_FILE_MB * 1048576)) \
    '$4 != "-" && $4 > m {sub(/^[^\t]*\t/, "", $0); printf "%s\n", $0}')
  if [ -n "$big" ]; then
    echo "pre-push: files over $MAX_FILE_MB MB (keep them outside git):" >&2
    echo "$big" | sed 's/^/  /' >&2
    fail=1
  fi
  if [ "$remote_sha" = "$ZERO" ]; then
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null || true)  # a new branch: what it adds to main
  else
    base=$remote_sha
  fi
  if [ -n "$base" ] && git cat-file -e "$base^{commit}" 2>/dev/null; then
    bytes=0
    added=""
    while IFS= read -r -d '' f; do
      if printf '%s\n' "$f" | grep -qiE "$BINARY"; then
        bytes=$((bytes + $(git cat-file -s "$local_sha:$f")))
        added="$added  $f"$'\n'
      fi
    done < <(git diff --diff-filter=AM --name-only -z "$base" "$local_sha")
    if [ "$bytes" -gt $((MAX_ADDED_MB * 1048576)) ]; then
      echo "pre-push: this push adds $((bytes / 1048576)) MB of binaries (over $MAX_ADDED_MB MB):" >&2
      printf '%s' "$added" >&2
      fail=1
    fi
  fi
done

[ "$checked" = 1 ] || exit 0

hist=$(git count-objects -v 2>/dev/null | awk '/size-pack/ {print int($2 / 1024)}')
if [ "$hist" -gt "$WARN_HISTORY_MB" ]; then
  echo "pre-push: warning: the history is $hist MB (warn at $WARN_HISTORY_MB, GitHub's soft limit is 1 GB)." >&2
fi
[ "$fail" = 0 ] || { echo "pre-push: push blocked." >&2; exit 1; }

# All checks. The review, when the clone has one, looks at the pushed commits.
if [ -n "${base:-}" ] && git cat-file -e "$base^{commit}" 2>/dev/null; then
  exec scripts/check.sh "$base" </dev/null
fi
exec scripts/check.sh </dev/null
